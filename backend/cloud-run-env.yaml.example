# Copy this content into the CLOUD_RUN_ENV_VARS GitHub repository secret and
# replace every placeholder. This YAML file is supplied to Cloud Run at deploy time.
# Do not add PORT: Cloud Run provides it and the workflow configures port 10000.
DATABASE_TYPE: postgresql
DATABASE_HOST: your-supabase-session-pooler-host
DATABASE_PORT: "5432"
DATABASE_NAME: postgres
DATABASE_USER: your-supabase-pooler-user
DATABASE_PASSWORD: replace-with-your-supabase-password
DATABASE_URL_PARAMETERS: "?sslmode=require"
JWT_SECRET: replace-with-a-random-32-byte-minimum-secret
REDIS_HOST: your-upstash-endpoint
REDIS_PORT: "6379"
REDIS_USERNAME: default
REDIS_PASSWORD: replace-with-your-upstash-password
REDIS_SSL_ENABLED: "true"
OPENAI_API_KEY: ""
OPENAI_API_MODEL: gpt-4o-mini
# Use update only for the first deployment against an empty database. Move to
# validate after schema migrations are managed explicitly.
SPRING_JPA_HIBERNATE_DDL_AUTO: update
CORS_ALLOWED_ORIGINS: https://hospital-management-2be.pages.dev
