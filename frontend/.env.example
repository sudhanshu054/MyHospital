# Frontend environment configuration – copy this file to .env and fill values.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# Base URL of the backend API.
# Leave empty when running via Vite dev-server (proxy to localhost:8080 is
# already configured in vite.config.ts).
# Set to the full URL only when the frontend is served separately from the API,
# e.g. VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_API_BASE_URL=

# Google OAuth 2.0 Client ID (Web application type).
# Copy the same value as GOOGLE_OAUTH_CLIENT_ID from the root .env.
# When this is blank the Google sign-in buttons are shown as disabled.
# See docs/google-oauth-setup.md for how to create a client ID.
VITE_GOOGLE_OAUTH_CLIENT_ID=
