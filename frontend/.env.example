# Frontend environment – Vite exposes only variables prefixed with VITE_
# Copy this file to .env and fill in values for local development.
# Production values are set in the Render dashboard (render.yaml).

# Base URL of the backend API.
# Local dev: leave empty – vite.config.ts already proxies /api to localhost:8080
# Docker local: http://localhost:8080/api
# Render production: set automatically via render.yaml (https://hospital-backend.onrender.com/api)
VITE_API_BASE_URL=

# Google OAuth 2.0 Client ID (Web application type).
# Same value as GOOGLE_OAUTH_CLIENT_ID in the root .env.
# When blank, the Google sign-in buttons are shown as disabled.
# See docs/google-oauth-setup.md for setup instructions.
VITE_GOOGLE_OAUTH_CLIENT_ID=
