{
  "name": "hospital-management-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --functions functions",
    "build": "tsc && vite build",
    "check:worker": "tsc --noEmit --target ES2022 --moduleResolution bundler --module ESNext --lib ES2022 --types @cloudflare/workers-types functions/api/[[path]].ts",
    "preview": "vite preview",
    "cf:pages:deploy": "npm run build && wrangler pages deploy dist --project-name hospital-management"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.6",
    "@mui/material": "^5.14.12",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.5.0",
    "axios": "^1.5.0",
    "chart.js": "^4.4.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "wrangler": "^4.118.0"
  }
}
